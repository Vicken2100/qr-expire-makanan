rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Default-deny global safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidItem(data) {
      return data.keys().hasAll(['id', 'name', 'mfgDate', 'expDate'])
        && data.keys().hasOnly([
          'id', 'name', 'mfgDate', 'expDate', 'batchNumber',
          'category', 'quantity', 'unit', 'notes', 'qrPayload',
          'scannedCount', 'lastScannedAt', 'createdAt', 'updatedAt', 'createdBy'
        ])
        && data.id is string && data.id.size() <= 128 && data.id.matches('^[a-zA-Z0-9_\\-]+$')
        && data.name is string && data.name.size() > 0 && data.name.size() <= 100
        && data.mfgDate is string && data.mfgDate.size() <= 10 && data.mfgDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.expDate is string && data.expDate.size() <= 10 && data.expDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && (!('batchNumber' in data) || (data.batchNumber is string && data.batchNumber.size() <= 50))
        && (!('category' in data) || (data.category is string && data.category.size() <= 50))
        && (!('quantity' in data) || (data.quantity is number && data.quantity >= 0))
        && (!('unit' in data) || (data.unit is string && data.unit.size() <= 20))
        && (!('notes' in data) || (data.notes is string && data.notes.size() <= 500))
        && (!('qrPayload' in data) || (data.qrPayload is string && data.qrPayload.size() <= 1000))
        && (!('scannedCount' in data) || (data.scannedCount is number && data.scannedCount >= 0))
        && (!('lastScannedAt' in data) || (data.lastScannedAt is string && data.lastScannedAt.size() <= 50))
        && (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 50) || (data.createdAt is timestamp))
        && (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 50) || (data.updatedAt is timestamp))
        && (!('createdBy' in data) || (data.createdBy is string && data.createdBy.size() <= 128));
    }

    function isValidScan(data) {
      return data.keys().hasAll(['id', 'itemId', 'status'])
        && data.keys().hasOnly(['id', 'itemId', 'itemName', 'status', 'daysRemaining', 'scannedAt', 'deviceInfo'])
        && data.id is string && data.id.size() <= 128 && data.id.matches('^[a-zA-Z0-9_\\-]+$')
        && data.itemId is string && data.itemId.size() <= 128 && data.itemId.matches('^[a-zA-Z0-9_\\-]+$')
        && data.status in ['green', 'yellow', 'red']
        && (!('itemName' in data) || (data.itemName is string && data.itemName.size() <= 100))
        && (!('daysRemaining' in data) || (data.daysRemaining is number))
        && (!('scannedAt' in data) || (data.scannedAt is string && data.scannedAt.size() <= 50) || (data.scannedAt is timestamp))
        && (!('deviceInfo' in data) || (data.deviceInfo is string && data.deviceInfo.size() <= 100));
    }

    // Master items collection for multi-device real-time sync
    match /items/{itemId} {
      allow get, list: if true;
      allow create: if isValidId(itemId) && isValidItem(request.resource.data) && request.resource.data.id == itemId;
      allow update: if isValidId(itemId) && isValidItem(request.resource.data) && request.resource.data.id == itemId;
      allow delete: if isValidId(itemId);
    }

    // Real-time scan logs across phones
    match /scans/{scanId} {
      allow get, list: if true;
      allow create: if isValidId(scanId) && isValidScan(request.resource.data) && request.resource.data.id == scanId;
      allow delete: if isValidId(scanId);
    }

    // Connection testing endpoint for health check
    match /test/{docId} {
      allow read: if true;
    }
  }
}
